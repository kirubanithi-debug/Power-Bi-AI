# ==========================================
# DJANGO BACKEND CONFIGURATION
# ==========================================
SECRET_KEY=django-insecure-change-this-in-production-key-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# DATABASE (SUPABASE POSTGRESQL)
# ==========================================
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres.xxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ==========================================
# AI / LLM SERVICE PROVIDER
# ==========================================
LLM_PROVIDER=openai # openai | gemini
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o-mini # or gemini-1.5-flash

# ==========================================
# MICROSOFT POWER BI EMBEDDING (SERVICE PRINCIPAL)
# ==========================================
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=your-azure-tenant-id
POWERBI_WORKSPACE_ID=your-powerbi-workspace-id
POWERBI_REPORT_ID=your-powerbi-report-id

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
VITE_API_BASE_URL=http://127.0.0.1:8000/api
